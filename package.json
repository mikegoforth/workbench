{
  "name": "workbench",
  "version": "0.1.4",
  "description": "A local control panel for every project in your projects folder",
  "author": "workbench contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "desktop:build": "next build && node scripts/build-desktop.mjs",
    "desktop": "npm run desktop:build && electron .",
    "desktop:dist": "npm run desktop:build && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^4.0.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "5.1.0"
  }
}
